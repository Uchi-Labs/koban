# Teller credentials for local sync.

# Teller

# SnapTrade (read-only brokerage holdings: e.g. Fidelity, Schwab, Coinbase)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional one-time seed to adopt an existing SnapTrade user (dashboard-created).
# Imported into sync_state on first use; DB storage is the source of truth afterwards.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# SimpleFIN Bridge (read-only bank/card balances + transactions).
# Paste the claimed Access URL here; keep it in ignored .env only.
SIMPLEFIN_ACCESS_URL=

# Plaid (read-only Transactions sync; manual only, no scheduled/webhook sync).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SANDBOX_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=
# Optional one-time seed: base64 JSON array of {item_id, access_token, institution_id}.
# Imported into sync_state on first use; DB storage is the source of truth afterwards.
PLAID_ITEMS_B64=

# App/runtime
NEXT_PUBLIC_APP_ENV=development
AI_FINANCES_AUTH_TOKEN=
DATABASE_URL=
POSTGRES_PASSWORD=
AI_FINANCES_PGLITE_DIR=
AI_FINANCES_LEDGER_BACKUP_PATH=
# Base URL used by scripts/sync-due.mjs when calling the running app.
AI_FINANCES_APP_URL=
# Set to 1 to skip loading workspace-level .env files (used by tests/e2e to isolate env).
AI_FINANCES_IGNORE_WORKSPACE_ENV=
# Hosted auth is enabled when DATABASE_URL is set.
# Run the Postgres auth migration with: pnpm --dir apps/web auth:migrate
# BETTER_AUTH_SECRET is required in hosted mode; use a long random value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Key for encrypting stored provider secrets: 32 random bytes in base64
# (openssl rand -base64 32). Required in hosted mode. Locally, leave it empty
# and the first boot writes one to data/local/secret-key (mode 0600).
KOBAN_SECRET_KEY=
# Optional dormant Google app-login provider. The button appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional hosted, read-only Outlook/Microsoft Graph source connection.
# Register this exact callback URI in Microsoft Entra:
# <app-origin>/api/auth/microsoft/callback
MICROSOFT_SOURCE_CLIENT_ID=
MICROSOFT_SOURCE_CLIENT_SECRET=
# Optional outside hosted mode. Hosted mode derives token encryption from BETTER_AUTH_SECRET.
MICROSOFT_SOURCE_TOKEN_ENCRYPTION_KEY=

# Optional LLM enrichment provider.
# none keeps AI enrichment local/deterministic; ollama calls a local Ollama server;
# openai_compatible calls <base>/chat/completions with an optional bearer key.
# Current OpenAI GPT-5-family chat models are supported with max_completion_tokens.
# Experimental: set AI_FINANCES_ENABLE_CHATGPT_OAUTH=1 to allow Settings sign-in
# through OpenAI's Codex OAuth client. This may violate OpenAI ToS for non-Codex
# use and can break at any time.
AI_FINANCES_LLM_PROVIDER=none
AI_FINANCES_LLM_BASE_URL=https://api.openai.com/v1
AI_FINANCES_LLM_API_KEY=
AI_FINANCES_ENABLE_CHATGPT_OAUTH=0
# One-time seed only. When present, the app imports this value into sync_state;
# DB storage is the source of truth afterward.
CHATGPT_OAUTH_TOKENS_B64=
# Optional fallback when AI_FINANCES_LLM_PROVIDER=openai_compatible and base URL is OpenAI.
OPENAI_API_KEY=
# Reasoning model powers assistant answer refinement; simple model powers enrichment and health checks.
AI_FINANCES_LLM_REASONING_MODEL=gpt-5.5
AI_FINANCES_LLM_SIMPLE_MODEL=gpt-5.4-mini
# Optional legacy/default fallback used when a scoped model is unset.
AI_FINANCES_LLM_MODEL=
AI_FINANCES_LLM_TIMEOUT_MS=45000

# Optional local evidence-source CLI auth consumed by the spawned CLI process.
OUTLOOK_EMAIL_TOKEN=

# Optional: hosted embeddings for semantic search (leave unset for local-only)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large
