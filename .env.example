# Teller credentials for local sync.

# Teller
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_TOKEN_SIGNING_PUBLIC_KEY=
TELLER_CERTIFICATE_ID=
TELLER_CERTIFICATE_PATH=
TELLER_PRIVATE_KEY_PATH=
TELLER_CERTIFICATE_B64=
TELLER_PRIVATE_KEY_B64=
TELLER_ACCESS_TOKEN=
TELLER_ENROLLMENT_ACCESS_TOKEN=
TELLER_ENROLLMENTS_B64=
TELLER_ENROLLMENT_ID=
TELLER_USER_ID=
TELLER_LAST_ENROLLED_AT=
TELLER_API_VERSION=2020-10-12
TELLER_SYNC_START_DATE=
TELLER_WEBHOOK_SECRET=

# App/runtime
NEXT_PUBLIC_APP_ENV=development
AI_FINANCES_AUTH_TOKEN=
DATABASE_URL=
POSTGRES_PASSWORD=
AI_FINANCES_PGLITE_DIR=
AI_FINANCES_TELLER_BACKUP_PATH=

# Optional LLM enrichment provider.
# none keeps AI enrichment local/deterministic; ollama calls a local Ollama server;
# openai_compatible calls <base>/chat/completions with an optional bearer key.
# Current OpenAI GPT-5-family chat models are supported with max_completion_tokens.
# Experimental: set AI_FINANCES_ENABLE_CHATGPT_OAUTH=1 to allow Settings sign-in
# through OpenAI's Codex OAuth client. This may violate OpenAI ToS for non-Codex
# use and can break at any time.
AI_FINANCES_LLM_PROVIDER=none
AI_FINANCES_LLM_BASE_URL=https://api.openai.com/v1
AI_FINANCES_LLM_API_KEY=
AI_FINANCES_ENABLE_CHATGPT_OAUTH=0
CHATGPT_OAUTH_TOKENS_B64=
# Optional fallback when AI_FINANCES_LLM_PROVIDER=openai_compatible and base URL is OpenAI.
OPENAI_API_KEY=
# Reasoning model powers assistant answer refinement; simple model powers enrichment and health checks.
AI_FINANCES_LLM_REASONING_MODEL=gpt-5.5
AI_FINANCES_LLM_SIMPLE_MODEL=gpt-5.4-mini
# Optional legacy/default fallback used when a scoped model is unset.
AI_FINANCES_LLM_MODEL=
AI_FINANCES_LLM_TIMEOUT_MS=45000

# Optional local evidence-source CLI auth consumed by the spawned CLI process.
OUTLOOK_EMAIL_TOKEN=

# Optional: hosted embeddings for semantic search (leave unset for local-only)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large
