{
  "name": "ai-finances",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node scripts/start-local-backend.mjs",
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "test": "pnpm --dir apps/web test",
    "test:copilot-import": "node --test scripts/copilot-import/import.test.mjs",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "sync:due": "pnpm --dir apps/web sync:due",
    "sync:now": "pnpm --dir apps/web sync:now",
    "sync:watch": "pnpm --dir apps/web sync:watch",
    "koban": "node packages/agent-interface/src/cli.js",
    "test:agent-interface": "pnpm --filter @ai-finances/agent-interface test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
